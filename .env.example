# DashScope API密钥，用于调用阿里云API服务
# 从 https://dashscope.console.aliyun.com/apiKey 获取
DASHSCOPE_API_KEY=your-api-key-here

# OpenAI API密钥（当前未使用）
OPENAI_API_KEY=your-openai-api-key-here

# 视频帧保存路径
# 用于存储视频处理过程中的帧图像
SAVE_PATH=./output_frames

# 测试视频路径
# 用于测试的自行车视频文件路径
test_video_path=./backend/uploads/raw.mp4

# 向量数据库存储路径
# 用于存储RAG系统的向量数据
VectorData_path=./backend/Light_rag/lr_db

# 源文件目录
# 存放需要处理的文档文件，支持PDF、Markdown、Word、PowerPoint等格式
PDF_SOURCE_DIR=./pdfs

# MD临时文件目录
# 存放文档转换后的MD文件的临时目录
MD_TEMP_DIR=./md_temp

# 是否使用本地Ollama模型 (true/false)
# true: 使用本地Ollama模型进行推理
# false: 使用线上API服务
USE_LOCAL_OLLAMA=false

# Ollama本地模型名称
# 当USE_LOCAL_OLLAMA=true时使用
# 支持的模型：qwen2.5:72b-instruct-q4_K_M等
OLLAMA_MODEL=qwen2.5:72b-instruct-q4_K_M 

# API服务基础URL
# 当USE_LOCAL_OLLAMA=false时使用
# 阿里云灵积模型服务地址
API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 线上API服务使用的模型名称
# 当USE_LOCAL_OLLAMA=false时使用
# 支持的模型：qwen-plus等
API_MODEL=qwen-plus 